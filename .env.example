# ── MongoDB (Firestore Mongo-compat) — ledger + music instrumentals ─────
# Used by server/tsm-ledger-service.js and
# server/tsm-music-instrumentals-service.js. This points at Firestore's
# MongoDB-compatibility endpoint for the tsm-rcm-prod project, database
# "tsm-consultz" — not a standalone MongoDB server.
#
# To generate a working value:
#   1. gcloud config set project tsm-rcm-prod
#   2. gcloud firestore user-creds create <a-username> --database=tsm-consultz
#      (prints a password ONCE — save it immediately)
#   3. Grant it access:
#      gcloud projects add-iam-policy-binding tsm-rcm-prod \
#        --member="principal://firestore.googleapis.com/projects/<PROJECT_NUMBER>/name/databases/tsm-consultz/userCreds/<a-username>" \
#        --role="roles/datastore.user" \
#        --condition='expression=resource.name == "projects/tsm-rcm-prod/databases/tsm-consultz",title=db-access'
#   4. Note: Firestore caches IAM changes for up to 5 minutes, so a fresh
#      grant may return "Missing or insufficient permissions" briefly.
#
# Format: mongodb://<username>:<password>@<host>:443/tsm-consultz
#           ?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
# retryWrites=false is required — Firestore's Mongo-compat layer doesn't
# support retryable writes.
MONGODB_URI=

# ── QuickBooks Online (ERP) integration ─────────────────────────────────
# From an Intuit Developer account: https://developer.intuit.com
# Create an app there, then pull these from its Keys & OAuth page.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Intuit app, e.g.:
#   http://localhost:3000/api/integrations/quickbooks/callback
QBO_REDIRECT_URI=
# 'sandbox' until this integration has been reviewed for production use —
# sandbox points at Intuit's fake company data, so there's no real
# financial data at risk while this is being built/tested.
QBO_ENVIRONMENT=sandbox

# ── Gmail integration (read-only) ───────────────────────────────────────
# From a Google Cloud project: https://console.cloud.google.com
# Enable the Gmail API, create an OAuth 2.0 Client ID (Web application),
# then pull these from its credentials page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client, e.g.:
#   http://localhost:3000/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI=
# Optional — Gmail search syntax. Defaults to 'is:unread newer_than:30d'.
GMAIL_QUERY=

# ── EHR integration (FHIR, read-only) ───────────────────────────────────
# Defaults to a PUBLIC synthetic test sandbox if left blank -- no real PHI,
# no signup required: https://hapi.fhir.org/baseR4
# Do NOT point this at a real EHR without a signed BAA and real
# SMART-on-FHIR OAuth in place -- neither is implemented in this codebase
# yet (see routes/integrations-fhir.js header).
FHIR_BASE_URL=
# Optional -- only needed if your FHIR test server requires a static
# bearer token. This is NOT equivalent to real SMART-on-FHIR OAuth.
FHIR_BEARER_TOKEN=
